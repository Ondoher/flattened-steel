  "response": {
    "id": "color-reset-cr4-total-horizontal-illuminance-rational-gain-v1",
    "input": "E = total horizontal receiver illuminance in lux",
    "equation": "g(E;G) = 1 + (G - 1) / (1 + (E / 68 lux)^4); outputRgb = clamp(brunetonRgb * g, 0, 1)",
    "operationSpace": "post-Bruneton display RGB",
    "rgbTreatment": "one identical gain for all three channels and every pixel before the final explicit display clamp",
    "transitionIlluminanceLux": 68,
    "rolloffPower": 4,
    "properties": {
      "finiteForAllNonnegativeIlluminance": true,
      "continuousValueAndSlope": true,
      "zeroIlluminanceDerivativePerLux": 0,
      "strictlyApproachesUnitGainAtIncreasingIlluminance": true,
      "hardIdentityCutoff": false,
      "namedSceneBranch": false
    },
    "candidates": [
      {"id": "restrained-256", "label": "Restrained (Gmax 256)", "maximumGain": 256, "transitionIlluminanceLux": 68, "rolloffPower": 4},
      {"id": "balanced-512", "label": "Balanced (Gmax 512)", "maximumGain": 512, "transitionIlluminanceLux": 68, "rolloffPower": 4},
      {"id": "strong-1024", "label": "Strong (Gmax 1024)", "maximumGain": 1024, "transitionIlluminanceLux": 68, "rolloffPower": 4}
    ]
  },
  "brunetonPreservationEnvelope": {
    "scope": "sky pixels whose total horizontal receiver illuminance satisfies the scalar applicability rule; candidate CPU quantization compared with CPU Bruneton quantization from the same CR1 float32 field",
    "applicability": {
      "equation": "E >= 1000 lux",
      "minimumIlluminanceLux": 1000,
      "evaluationOnly": true,
