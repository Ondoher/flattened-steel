  "publicationReferences": {
    "comparisonPolicy": "Normalize and compare only receiver-light or raw pre-display Y slopes. Koomen horizontal-plane receiver metrics use only the declared +5 through -9 degree solar-elevation overlap; the separate non-matched-direction Koomen zenith overlay uses its +5 through -15 degree domain. Patat metrics use only solar zenith 95 through 105 degrees. Full CR4I context may be drawn but cannot enter a comparison metric or gate. Do not fit screen RGB or candidate gain to publication values. Different locations, atmospheres, passbands, and view directions make every overlay contextual and report-only.",
    "koomen1952": {
      "citation": "Koomen et al., Measurements of the Brightness of the Twilight Sky, JOSA 42 (1952) 353-356",
      "officialUrl": "https://opg.optica.org/josa/abstract.cfm?uri=josa-42-5-353",
      "horizontalPlaneIllumination": {
        "role": "primary receiver-E normalized/log-slope comparison",
        "validSolarElevationDegrees": [-9, 5],
        "solarElevationDegrees": [5, 3, 0, -3, -6, -9],
        "footCandles": [2100, 1200, 180, 8.8, 0.5, 0.035],
        "lux": [22604.211875, 12916.6925, 1937.503875, 94.7224117, 5.38195521, 0.376736865]
      },
