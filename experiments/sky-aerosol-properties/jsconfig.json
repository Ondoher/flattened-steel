{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"maxNodeModuleJsDepth": 0,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": false,
		"target": "ES2022",
		"types": [
			"node"
		],
		"typeRoots": [
			"../../node_modules/@types"
		]
	},
	"include": [
		"../../scripts/algorithm32/solar-zenith-cache/types.d.ts",
		"../../src/algorithm32/**/*.d.ts",
		"**/*.d.ts",
		"**/*.js",
		"**/*.mjs"
	],
	"exclude": [
		"../../node_modules/**",
		"**/node_modules/**"
	]
}
