{
	"name": "distant-sun-recording-strobing",
	"private": true,
	"type": "module",
	"description": "Contained offline strobing diagnostics and correction experiment",
	"dependencies": {
		"ffmpeg-static": "5.3.0",
		"pngjs": "7.0.0"
	},
	"version": "0.0.1",
	"scripts": {
		"check": "tsc -p jsconfig.json",
		"capture:control": "node creative/run-creative-animation.js --control",
		"cache:generate": "node generate-candidate.js",
		"capture:candidate": "node creative/run-creative-animation.js --candidate",
		"film": "node creative/run-creative-animation.js --film",
		"analyze": "node analyze-capture.js",
		"field:probe": "node probe-field.js",
		"qualify:film": "node qualify-film.js",
		"publish:evidence": "node publish-evidence.js",
		"ground:probe": "node probe-ground.js"
	}
}
