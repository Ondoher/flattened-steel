{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "downloads-manifest.schema.json",
  "title": "Algorithm32 retained reference downloads manifest",
  "type": "object",
  "required": ["schemaVersion", "manifestId", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "title",
          "origin",
          "retrieval",
          "license",
          "byteLength",
          "sha256",
          "factIds",
          "locators"
        ],
        "properties": {
          "path": { "type": "string", "pattern": "^references/downloads/" },
          "title": { "type": "string", "minLength": 1 },
          "origin": { "type": "object" },
          "retrieval": { "type": "object" },
          "license": { "type": "object" },
          "byteLength": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "factIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "locators": { "type": "array", "minItems": 1, "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    }
  }
}
