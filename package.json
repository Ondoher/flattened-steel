{
	"name": "polylith-project",
	"version": "0.1.0",
	"description": "Initial setup for a polylith project",
	"dependencies": {
		"@polylith/browser": "^1.1.0",
		"@polylith/builder": "^1.1.0",
		"@polylith/config-store": "^1.1.0",
		"@polylith/core": "^1.1.0",
		"@react-three/fiber": "^8.18.0",
		"nodemon": "^3.0.1",
		"polylith": "^1.1.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"three": "^0.180.0"
	},
	"devDependencies": {
		"@polylith/server": "^1.1.0",
		"@rollup/plugin-node-resolve": "13.3.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/three": "^0.180.0",
		"jasmine": "^4.5.0",
		"jasmine-core": "^4.5.0",
		"karma": "^6.4.1",
		"karma-chrome-launcher": "^3.1.1",
		"karma-jasmine": "^5.1.0",
		"karma-jasmine-html-reporter": "^2.0.0",
		"karma-spec-reporter": "^0.0.36",
		"prettier": "3.9.6",
		"puppeteer": "^19.4.1",
		"rollup": "2.80.0",
		"typescript": "^5.9.3"
	},
	"nodemonConfig": {
		"delay": 2500,
		"watch": [
			"server",
			"config"
		],
		"exec": "npm start"
	},
	"scripts": {
		"format:check": "prettier --check .",
		"test:animation-evidence": "node --test --test-isolation=none scripts/animation-evidence/animation-evidence.test.js",
		"typecheck:animation-evidence": "tsc -p scripts/animation-evidence/jsconfig.json",
		"verify:animation-evidence:browser": "node scripts/animation-evidence/verify-browser-compatibility.js",
		"verify:animation-evidence:run": "node scripts/animation-evidence/verify-browser-run.js",
		"experiment:distant-sun-cache:e1": "node experiments/distant-sun-cache-optimization/run-e1-format-compression.js",
		"experiment:distant-sun-cache:e2": "node experiments/distant-sun-cache-optimization/run-e2-browser-transport.js",
		"experiment:distant-sun-cache:e3": "node experiments/distant-sun-cache-optimization/run-e3-bounded-generator.js",
		"verify:experiment:distant-sun-cache:run": "node experiments/distant-sun-cache-optimization/verify-run.js",
		"verify:experiment:distant-sun-cache:e1-contracts": "node experiments/distant-sun-cache-optimization/verify-e1-contracts.js",
		"test": "npm run test:server:flat32 && start polylith test -a -w && start karma start --browsers ChromeHeadless karma.conf.cjs",
		"test:server:flat32": "node --test server/flat32/spec.js",
		"qualify:algorithm32:shared-runtime": "node scripts/algorithm32/solar-zenith-cache/qualify-shared-runtime.js",
		"typecheck:algorithm32:shared-runtime": "tsc -p scripts/algorithm32/solar-zenith-cache/shared-runtime-jsconfig.json",
		"build:algorithm32:distant-sun-cache": "node scripts/algorithm32/solar-zenith-cache/build-distant-sun-scene-cache.js",
		"build:algorithm32:distant-sun-cache:shared": "node scripts/algorithm32/solar-zenith-cache/generate-shared-cache.js",
		"verify:algorithm32:shared-publication-failure": "node scripts/algorithm32/solar-zenith-cache/verify-shared-cache-publication-failure.js",
		"test:algorithm32:shared-generation": "node --test scripts/algorithm32/solar-zenith-cache/shared-cache-generation.test.js",
		"typecheck:algorithm32:shared-generation": "tsc -p scripts/algorithm32/solar-zenith-cache/jsconfig.json",
		"materialize:algorithm32:brightest-2000-stars": "node scripts/algorithm32/materialize-brightest-2000-stellar-package.js",
		"verify:algorithm32:brightest-2000-stars": "node scripts/algorithm32/verify-brightest-2000-stellar-package.js",
		"materialize:algorithm32:human-vision-filters": "node scripts/algorithm32/materialize-human-vision-filter-package.js",
		"verify:algorithm32:human-vision-filters": "node scripts/algorithm32/verify-human-vision-filter-package.js",
		"verify:algorithm32:distant-sun-cache:pa3": "node scripts/algorithm32/solar-zenith-cache/verify-pa3-resident-cache-browser.js",
		"verify:algorithm32:distant-sun-cache:pa4": "node scripts/algorithm32/solar-zenith-cache/verify-pa4-live-transport-browser.js",
		"verify:algorithm32:distant-sun-cache:pa5": "node scripts/algorithm32/solar-zenith-cache/verify-pa5-lifecycle-browser.js",
		"verify:algorithm32:distant-sun-cache:pa6": "node scripts/algorithm32/solar-zenith-cache/verify-pa6-production-qualification.js",
		"verify:flat32:distant-sun-performance": "node scripts/flat32/verify-distant-sun-runtime-performance.js",
		"build:algorithm32:distant-sun-cache:pa6-scenes": "node scripts/algorithm32/solar-zenith-cache/build-pa6-six-scene-caches.js",
		"build:algorithm32:distant-sun-cache:one-degree-inventory": "node scripts/algorithm32/solar-zenith-cache/build-one-degree-scene-cache-inventory.js",
		"verify:algorithm32:distant-sun-cache:one-degree-inventory": "node scripts/algorithm32/solar-zenith-cache/verify-one-degree-scene-cache-inventory.js",
		"finalize:algorithm32:distant-sun-cache:pa6": "node scripts/algorithm32/solar-zenith-cache/finalize-pa6-production-qualification.js",
		"test:algorithm32": "jasmine --config=spec/support/jasmine-algorithm32.json",
		"test:algorithm32:three": "karma start spec/support/karma-algorithm32-three.conf.cjs --single-run",
		"clean:flat32": "node scripts/flat32/clean-build-output.js",
		"build:flat32": "npm run clean:flat32 && polylith build flat32 && npm run build:algorithm32:shared-worker",
		"build:algorithm32:shared-worker": "node scripts/algorithm32/solar-zenith-cache/build-shared-cache-worker.js",
		"package:flat32:distant-sun-caches": "node scripts/algorithm32/solar-zenith-cache/assemble-bin-covered-runtime-packages.js",
		"build:test:flat32": "polylith test flat32 --group browser",
		"karma:flat32": "karma start spec/support/karma-flat32.conf.cjs --single-run",
		"karma:flat32:full": "karma start spec/support/karma-flat32-full.conf.cjs --single-run",
		"test:ui:flat32": "npm run build:flat32 && npm run build:test:flat32 && npm run karma:flat32",
		"test:ui:flat32:full": "npm run build:flat32 && npm run build:test:flat32 && npm run karma:flat32:full",
		"test:acceptance:lighting": "npm run typecheck:algorithm32 && npm run typecheck:flat32 && npm run test:algorithm32 && npm run test:ui:flat32",
		"typecheck:flat32": "tsc -p src/flat32/jsconfig.json",
		"typecheck:algorithm32": "tsc -p src/algorithm32/jsconfig.json",
		"test:algorithm32-flat-local-convergence-policy": "node --test --test-isolation=none scripts/experiments/flat-local-cache-domain-convergence/flat-local-cache-domain-convergence-policy.test.js",
		"test:algorithm32:b1-production": "node --test --test-isolation=none scripts/algorithm32/production-b-experiments/B1Direct40CacheAssetManifest.test.js scripts/algorithm32/production-b-experiments/B1Direct40CacheAssetSetManifest.test.js scripts/algorithm32/production-b-experiments/B1Direct40OfflineAssetAdapter.test.js scripts/algorithm32/production-b-experiments/B1Direct40AssetCache.test.js scripts/algorithm32/production-b-experiments/B1MeasurementBoundary.test.js scripts/algorithm32/production-b-experiments/DistantSunProfileCompilerInputs.test.js scripts/experiments/b1-directional-sky-radiance/production-profile.test.js scripts/experiments/b1-directional-sky-radiance/generate-production-boundary.test.js scripts/experiments/b1-directional-sky-radiance/ProductionProgressCacheBackend.test.js scripts/experiments/b1-directional-sky-radiance/ProductionRun.test.js scripts/experiments/b1-directional-sky-radiance/score-production-run.test.js scripts/experiments/b1-directional-sky-radiance/compare-production-backends.test.js scripts/experiments/b1-directional-sky-radiance/OutgoingDirectionDiagnosticDomain.test.js",
		"build:algorithm32:b1-direct40-assets": "node scripts/algorithm32/production-b-experiments/build-b1-direct40-cache-assets.js",
		"verify:algorithm32:b1-direct40-assets": "node scripts/algorithm32/production-b-experiments/verify-b1-direct40-cache-assets.js",
		"generate:algorithm32:b1-production": "node scripts/experiments/b1-directional-sky-radiance/generate-production-boundary.js",
		"generate:algorithm32:b1-production:cpu": "node scripts/experiments/b1-directional-sky-radiance/generate-production-boundary.js --backend cpu",
		"generate:algorithm32:b1-production:gpu": "node scripts/experiments/b1-directional-sky-radiance/generate-production-boundary.js --backend gpu",
		"score:algorithm32:b1-production": "node scripts/experiments/b1-directional-sky-radiance/publish-production-result.js references/results/experiments/b1-directional-sky-radiance/gpu",
		"score:algorithm32:b1-b3-production": "node scripts/experiments/b1-directional-sky-radiance/score-production-run.js",
		"compare:algorithm32:b1-production-backends": "node scripts/experiments/b1-directional-sky-radiance/compare-production-backends.js",
		"compare:algorithm32:bruneton-sky-color": "node experiments/extraterrestrial/runners/run-bruneton-shader-sky-color-comparison.js",
		"gate:algorithm32:bruneton-sky-color": "npm run generate:algorithm32:b1-production:gpu && npm run score:algorithm32:b1-production && npm run compare:algorithm32:bruneton-sky-color",
		"dev": "start polylith watch --all -v false&start npm run dev:serve",
		"karma": "karma start --browsers ChromeHeadless karma.conf.cjs",
		"dev:tests": "polylith test -a -w",
		"dev:watch": "polylith watch --all -v false",
		"dev:serve": "nodemon",
		"build": "polylith build --all && npm run build:algorithm32:shared-worker",
		"start": "polylith serve --all"
	},
	"type": "module"
}
