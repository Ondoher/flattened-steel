{
	"name": "flat32",
	"dest": "dist/flat32",
	"source": "src/flat32",
	"index": "src/flat32/index.js",
	"spec": "src/flat32/spec.js",
	"router": "server/flat32-router.js",
	"template": {
		"source": "src/flat32/templates/index.html",
		"destination": "dist/flat32/index.html"
	},
	"testDest": "tests/flat32",
	"testGroups": {
		"browser": {
			"name": "Flat32 Browser",
			"description": "Observable Flat32 application behavior in Chrome.",
			"root": "src/flat32",
			"specs": ["_tests/**/*.browser.js"]
		}
	},
	"resources": [
		{
			"dest": "images",
			"cwd": "images",
			"glob": "**/*.{png,jpg,gif,svn}",
			"keepNest": true
		}
	],
	"css": [
		{
			"dest": "styles",
			"cwd": "assets/css",
			"glob": "**/*.css",
			"keepNest": true
		}
	]
}
