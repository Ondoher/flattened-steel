{
	"name": "flat",
	"dest": "dist/flat",
	"source": "src/flat",
	"index": "src/flat/index.js",
	"spec": "src/flat/spec.js",
	"testDest": "tests/flat",
	"router": "server/flat/index.js",
	"routerRoot": "/flat",
	"template": {
		"source": "src/flat/templates/index.html",
		"destination": "dist/flat/index.html"
	},
	"css": [
		{
			"dest": "styles",
			"cwd": "styles",
			"glob": "**/*.css",
			"keepNest": true
		}
	],
	"features": [
		"features/app",
		"features/workspace"
	]
}
