{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"maxNodeModuleJsDepth": 0,
		"target": "ES2022",
		"types": ["react", "react-dom"],
		"skipLibCheck": true,
		"strict": false
	},
	"include": ["**/*.js", "**/*.jsx", "**/*.d.ts"],
	"exclude": ["**/_tests/**", "testing/**", "spec.js", "../../node_modules/**"]
}
