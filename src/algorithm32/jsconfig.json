{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"maxNodeModuleJsDepth": 0,
		"jsx": "react-jsx",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": false,
		"target": "ES2022",
		"types": []
	},
	"include": ["**/*.d.ts", "**/*.js", "**/*.jsx"],
	"exclude": ["**/_tests/**", "../../node_modules/**", "**/node_modules/**"]
}
