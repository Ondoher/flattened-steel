{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"maxNodeModuleJsDepth": 0,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"types": ["node"],
		"typeRoots": ["../../../node_modules/@types"]
	},
	"include": ["*.js", "*.d.ts", "types/*.d.ts"],
	"exclude": ["../../../node_modules/**"]
}
