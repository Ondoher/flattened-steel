  "claimBoundary": {
    "summary": "This is a labeled qualitative color, gradient, and angular-structure comparison only. It is not an RMSE, similarity, validation, model-ranking, measurement, or absolute-accuracy experiment.",
    "mandatoryStatements": [
      "The paper and Algorithm32 scenes differ in date, geographic location, atmospheric profile, solar-zenith angle, source azimuth, and spectral discretization.",
      "The paper's Figure 9 sunrise panels are uniformly normalized per model to 36 W/m^2 total sky irradiance, so they cannot support an absolute-brightness judgment.",
      "The paper's Figure 1 z87 row has no measured-sky panel and therefore supplies no measurement authority.",
      "The retained paper panels are 8-bit display PNGs, not spectral radiance or luminance fields.",
      "Algorithm32 uses the accepted production Native15 basis and Q30 camera-path transport; the paper panels do not use that wavelength contract.",
      "Source-relative rotational alignment assumes a horizontally homogeneous atmosphere and spherical ground and is only a display-alignment operation.",
      "No paper-panel pixel difference, resemblance score, RMSE, threshold, pass, failure, or model ordering is permitted.",
      "The z87 bridge reduces the solar-zenith mismatch but does not make the atmosphere, wavelength basis, date, or location equivalent.",
      "The actual San Jose sunset row is the product-facing subject; the z87 row is an orientation and low-Sun bridge only."
    ],
    "allowedObservations": [
      "qualitative hue family",
      "warm-horizon versus blue-upper-sky separation",
      "smoothness and spatial extent of gradients",
      "location and shape of angular structures",
      "whether normalized and absolute presentations lead to different visual conclusions"
    ],
    "objectiveAccuracyClaim": false,
    "appearanceAcceptanceGate": false,
    "similarityMetricGate": false,
    "rmseGate": false
  },
