{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flattened-steel.local/schemas/extraterrestrial/g0-decision-manifest-v1.schema.json",
  "title": "Stage 12 G0 decision manifest",
  "description": "Deterministic G0 decisions and references. Mutable topic documents may be cited separately but are not identity-bearing manifest inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "familyId",
    "experimentRoots",
    "baselineManifest",
    "candidateSeed",
    "schemas",
    "fixtures",
    "decisions",
    "proofAssertions",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "g0-decision-manifest-v1"
    },
    "manifestId": {
      "const": "stage12-g0-contract-v1"
    },
    "familyId": {
      "const": "spherical-sun-stars-radial-v1"
    },
    "experimentRoots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "output"
      ],
      "properties": {
        "source": {
          "const": "scripts/extraterrestrial"
        },
        "output": {
          "const": "tmp/extraterrestrial"
        }
      }
    },
    "baselineManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "aggregateHash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^scripts/extraterrestrial/"
        },
        "aggregateHash": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "candidateSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregateHash",
        "identicalToBaseline"
      ],
      "properties": {
        "aggregateHash": {
          "$ref": "#/$defs/fingerprint"
        },
        "identicalToBaseline": {
          "const": true
        }
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/contentReference"
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contentReference"
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "proofAssertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "contentHash": {
      "$ref": "#/$defs/fingerprint"
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^scripts/extraterrestrial/"
        },
        "sha256": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "constraints",
        "ownerGoal",
        "changeRule",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "status": {
          "enum": [
            "fixed",
            "provisional",
            "deferred"
          ]
        },
        "value": true,
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ownerGoal": {
          "type": "string",
          "pattern": "^(G[0-9]|12\\.10)$"
        },
        "reconsiderByGoal": {
          "type": "string",
          "pattern": "^(G[0-9]|12\\.10)$"
        },
        "changeRule": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "fixed",
                  "provisional"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "provisional",
                  "deferred"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reconsiderByGoal"
            ]
          }
        }
      ]
    }
  }
}
