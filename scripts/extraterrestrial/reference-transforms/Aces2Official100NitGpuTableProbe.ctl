// Read-only GPU-port parity surface over the exact tables generated by the
// pinned ACES 2 100-nit Rec.709/D65 core. This exposes the upper-hull gamma
// table separately from hue so a packed GPU texture cannot conflate their two
// intentionally different interpolation weights.

import "Lib.Academy.Utilities";
import "Lib.Academy.Tonescale";
import "Lib.Academy.OutputTransform";

const Chromaticities LIMITING_REC709_D65 =
    {
        {0.6400, 0.3300},
        {0.3000, 0.6000},
        {0.1500, 0.0600},
        {0.3127, 0.3290}
    };

const ODTParams GPU_PORT_ODT_PARAMS = init_ODTParams(100., LIMITING_REC709_D65);

void main(
    input varying float rIn,
    input varying float gIn,
    input varying float bIn,
    input varying float aIn,
    output varying float rOut,
    output varying float gOut,
    output varying float bOut,
    output varying float aOut)
{
    int index = min(max(int(floor(rIn + 0.5)), 0), totalTableSize - 1);
    if (gIn < 0.5)
    {
        rOut = GPU_PORT_ODT_PARAMS.TABLE_hues[index];
        gOut = GPU_PORT_ODT_PARAMS.TABLE_gamut_cusps[index][0];
        bOut = GPU_PORT_ODT_PARAMS.TABLE_gamut_cusps[index][1];
        aOut = GPU_PORT_ODT_PARAMS.TABLE_upper_hull_gamma[index];
    }
    else
    {
        if (index == 0)
        {
            rOut = base_hue_for_position(tableSize - 1, tableSize) - hue_limit;
        }
        else if (index == totalTableSize - 1)
        {
            rOut = base_hue_for_position(0, tableSize) + hue_limit;
        }
        else
        {
            rOut = base_hue_for_position(index - baseIndex, tableSize);
        }
        gOut = GPU_PORT_ODT_PARAMS.limit_J_max;
        bOut = GPU_PORT_ODT_PARAMS.TABLE_reach_M[index];
        aOut = GPU_PORT_ODT_PARAMS.ts.forward_limit;
    }
}
